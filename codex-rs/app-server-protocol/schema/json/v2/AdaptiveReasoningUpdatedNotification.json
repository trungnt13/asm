{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AdaptiveReasoningError": {
      "description": "Describes a Decisions failure without exposing request or response content.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "credentials"
              ],
              "title": "CredentialsAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "CredentialsAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "invalidRequest"
              ],
              "title": "InvalidRequestAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "InvalidRequestAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "transport"
              ],
              "title": "TransportAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "TransportAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "timeout"
              ],
              "title": "TimeoutAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "TimeoutAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "status": {
              "format": "uint16",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "http"
              ],
              "title": "HttpAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "status",
            "type"
          ],
          "title": "HttpAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "responseTooLarge"
              ],
              "title": "ResponseTooLargeAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "ResponseTooLargeAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "invalidResponse"
              ],
              "title": "InvalidResponseAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "InvalidResponseAdaptiveReasoningError",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "rejected"
              ],
              "title": "RejectedAdaptiveReasoningErrorType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "RejectedAdaptiveReasoningError",
          "type": "object"
        }
      ]
    }
  },
  "description": "Reports an immediate runtime-mode change, before any subsequent model step.",
  "properties": {
    "adaptiveReasoningRevision": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/definitions/AdaptiveReasoningError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failureEpisode": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "threadId"
  ],
  "title": "AdaptiveReasoningUpdatedNotification",
  "type": "object"
}